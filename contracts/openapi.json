                "schema": {
                  "$ref": "#/components/schemas/OkResultDto_Output"
                }
              }
            }
          }
        },
        "summary": "Logout — borra la cookie del cliente. Sin blocklist: un Bearer token capturado sigue válido hasta expirar (ver ADR 0007).",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/chat": {
      "post": {
        "operationId": "ChatController_chat",
