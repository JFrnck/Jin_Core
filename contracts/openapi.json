  "info": {
    "title": "Jin Core API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthReportDto_Output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded",
              "error"
            ]
          },
          "postgres": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          },
          "redis": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          }
        },
        "required": [
          "status",
          "postgres",
          "redis"
        ],
        "additionalProperties": false
      },
      "ListRecentResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "requestId": {
                  "type": "string"
                },
                "timestamp": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                },
                "actor": {
                  "type": "string"
                },
                "actionType": {
                  "type": "string"
                },
                "toolName": {
                  "type": "string",
                  "nullable": true
                },
                "inputsHash": {
                  "type": "string"
                },
                "planSummary": {
                  "type": "string",
                  "nullable": true
                },
                "approvalStatus": {
                  "type": "string"
                },
                "approver": {
                  "type": "string",
                  "nullable": true
                },
                "externalInputsSummary": {
                  "type": "string",
                  "nullable": true
                },
                "prevHash": {
                  "type": "string"
                },
                "currentHash": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "requestId",
                "timestamp",
                "actor",
                "actionType",
                "toolName",
                "inputsHash",
                "planSummary",
                "approvalStatus",
                "approver",
                "externalInputsSummary",
                "prevHash",
                "currentHash"
              ]
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "PendingApprovalDto": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "toolName": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "inputsHash": {
            "type": "string"
          },
          "planSummary": {
            "type": "string",
            "nullable": true
          },
          "payload": {},
          "actor": {
            "type": "string",
            "nullable": true
          },
          "externalInputsSummary": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "firstApprovedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
            "nullable": true
          },
          "firstApprover": {
            "type": "string",
            "nullable": true
          },
          "availableAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
            "nullable": true
          },
          "escalatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
            "nullable": true
          },
          "executingAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
            "nullable": true
          },
          "executionError": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "requestId",
          "toolName",
          "level",
          "inputsHash",
          "planSummary",
          "payload",
          "actor",
          "externalInputsSummary",
          "createdAt",
          "firstApprovedAt",
          "firstApprover",
          "availableAt",
          "escalatedAt",
          "executingAt",
          "executionError"
        ]
      },
      "ChangeModeResult_Output": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "applied"
                ]
              },
              "mode": {
                "type": "string",
                "enum": [
                  "supervised",
                  "semi-auto",
                  "auto"
                ]
              },
              "expiresAt": {
                "type": "string",
                "nullable": true
              }
            },
            "required": [
              "status",
              "mode",
              "expiresAt"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "pending-approval"
                ]
              },
              "requestId": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "supervised",
                  "semi-auto",
                  "auto"
                ]
              },
              "hours": {
                "type": "number"
              }
            },
            "required": [
              "status",
              "requestId",
              "mode",
              "hours"
            ],
            "additionalProperties": false
          }
        ]
      },
      "OkResultDto_Output": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      },
      "BudgetStatusDto_Output": {
        "type": "object",
        "properties": {
          "dailyUsageRatio": {
            "type": "number"
          },
          "dailyUsageUsd": {
            "type": "number"
          },
          "dailyUsageTokens": {
            "type": "number"
          },
          "dailyLimitUsd": {
            "type": "number"
          },
          "dailyLimitTokens": {
            "type": "number"
          },
          "killSwitchActive": {
            "type": "boolean"
          },
          "killSwitch": {
            "type": "object",
            "properties": {
              "activatedAt": {
                "type": "string",
                "nullable": true
              },
              "reason": {
                "type": "string",
                "nullable": true
              },
              "currentHourTokens": {
                "type": "number"
              },
              "avgHourlyTokens": {
                "type": "number"
              }
            },
            "required": [
              "activatedAt",
              "reason",
              "currentHourTokens",
              "avgHourlyTokens"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "dailyUsageRatio",
          "dailyUsageUsd",
          "dailyUsageTokens",
          "dailyLimitUsd",
          "dailyLimitTokens",
          "killSwitchActive",
          "killSwitch"
        ],
        "additionalProperties": false
      },
      "RecallDto": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "k": {
