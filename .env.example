# Copia a .env para desarrollo local. En producción, estas variables las
# inyecta Infisical al startup (AGENTS.md 5.2) — nunca env plano en la VM.
#
# Postgres/Redis locales: docker compose -f ../Jin_Infra/docker-compose.dev.yaml up -d

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://jin:jin@localhost:5432/jin
REDIS_URL=redis://localhost:6379

# Fase 6.1 (auth) — OWNER_PASSWORD_HASH se genera con:
#   pnpm run hash-password
# JWT_SECRET: cualquier string de 32+ caracteres para desarrollo local.
OWNER_PASSWORD_HASH=
JWT_SECRET=

# Requeridas por env.schema.ts (fail-fast) pero no invocadas solo por
# levantar el server — un valor cualquiera alcanza mientras no ejerzas
# la integración real (mismo criterio que usa .github/workflows/ci.yml).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CANVAS_BASE_URL=https://canvas.local.dev
CANVAS_API_TOKEN=dev-not-real
TELEGRAM_BOT_TOKEN=dev-not-real
TELEGRAM_OWNER_CHAT_ID=1
TELEGRAM_WEBHOOK_SECRET=dev-not-real
GOOGLE_CLIENT_ID=dev-not-real
GOOGLE_CLIENT_SECRET=dev-not-real
GOOGLE_REFRESH_TOKEN=dev-not-real
OPENAI_API_KEY=dev-not-real
EXECUTOR_BASE_URL=http://localhost:3001
